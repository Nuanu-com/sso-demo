# Nuanu SSO demo - configuration
#
# APP_ENV picks the file that is loaded at boot:
#   local (default) -> .env.local      staging -> .env.staging
#   test            -> .env.test       production -> .env
#
# Nothing here overrides a variable that is already set in the environment, so a
# real deployment can ignore these files entirely.

APP_ENV=local
# NODE_ENV is deliberately unset here. It only ever needs to be "production",
# which is what switches asset serving from the vite dev server to the built
# manifest; the Dockerfile sets it. Vite rejects any other value in a .env file.
VITE_SERVER_PORT=5173

# --- Nuanu SSO ---------------------------------------------------------------

# The only endpoint that is configured. Everything else - authorization, token,
# userinfo, end_session, jwks - is read from the discovery document at
# {SSO_BASE_URL}/.well-known/openid-configuration.
#
#   local    http://127.0.0.1:8000
#   staging  https://stg.sso.nuanu.com
SSO_BASE_URL=http://127.0.0.1:8000

# From client registration. An SSO superuser creates the client:
#
#   curl -X POST "{SSO}/api/v1/oauth_clients/" \
#     -H "Authorization: Bearer <superuser_access_token>" \
#     -H "Content-Type: application/json" \
#     -d '{"client_name": "SSO Demo",
#          "allowed_redirect_urls": "http://localhost:3001/auth/callback,http://localhost:3001/auth/logout/callback"}'
#
# The secret is shown in full only in that response.
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=

# Must be listed verbatim in the client's allowed_redirect_urls: the server
# compares them as exact strings. Keep the path clean - the callback arrives as
# an HTML GET form, which replaces any query string already on the URL.
SSO_REDIRECT_URI=http://localhost:3001/auth/callback
SSO_POST_LOGOUT_REDIRECT_URI=http://localhost:3001/auth/logout/callback

# Space-delimited and must contain openid. profile covers name, picture,
# birthdate and nationality; email covers email; phone covers phone_number.
SSO_SCOPES=openid profile email phone

# Mirror of the client's id_token_signed_response_alg, which is a per-client
# server-side setting nothing in the protocol exposes. HS256 (the registration
# default) is verified with the client secret; RS256 against the JWKS. Ask the
# auth team before changing this - the server has to be switched first.
SSO_ID_TOKEN_ALG=HS256

# Optional. Selects the organization branding on the SSO login pages.
SSO_DEPARTMENT_ID=

# Skip the discovery fetch and use the documented default paths. Only useful
# offline or in tests.
SSO_SKIP_DISCOVERY=false

# --- Session -----------------------------------------------------------------

# Sessions are in memory, so this only has to be stable within a process today.
# A shared session store would make it matter - generate a real one there.
SESSION_SECRET=dev-only-insecure-session-secret
SESSION_IDLE_TIMEOUT_MINUTES=60

# Set true wherever the app is served over HTTPS.
COOKIE_SECURE=false
